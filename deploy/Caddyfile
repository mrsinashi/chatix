chatix.lan {
    tls /etc/chatix/certs/chatix.lan.crt /etc/chatix/certs/chatix.lan.key

    request_body {
        max_size 5GB
    }

    # Прокси для health-чеков
    handle /healthz {
        reverse_proxy 127.0.0.1:8080
    }

    handle /readyz {
        reverse_proxy 127.0.0.1:8080
    }

    # API проксируется на Go-сервер
    handle /api/* {
        reverse_proxy 127.0.0.1:8080
    }

    # WebSocket
    handle /ws {
        reverse_proxy 127.0.0.1:8080 {
            header_up Connection {header_up.Connection}
            header_up Upgrade {header_up.Upgrade}
        }
    }

    # Статика клиента
    handle {
        root * /opt/chatix/client/dist
        file_server
        try_files {path} /index.html
    }
}